{
  "name": "@yzlaboratory/shh",
  "version": "0.1.2",
  "description": "A radical no-comments linter for JavaScript and TypeScript.",
  "keywords": [
    "comments",
    "linter",
    "cli",
    "typescript",
    "javascript",
    "pre-commit",
    "shh"
  ],
  "license": "MIT",
  "author": "yz <x@yzlaboratory.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzlaboratory/shh.git"
  },
  "bugs": {
    "url": "https://github.com/yzlaboratory/shh/issues"
  },
  "homepage": "https://github.com/yzlaboratory/shh#readme",
  "type": "module",
  "bin": {
    "shh": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-executable.mjs",
    "dev": "tsx src/cli.ts",
    "prepare": "npm run build && node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "check:version": "node scripts/check-version.mjs",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "test:watch": "npm run build && node --import tsx --test --watch test/*.test.ts",
    "check": "npm run build && node dist/cli.js check src test",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@babel/parser": "^7.29.12",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.14",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
